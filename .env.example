# Optional: leave blank to idempotently register/reuse the Customer Support RAG project.
TRACELENS_PROJECT_ID=
TRACELENS_API_URL=http://127.0.0.1:8000
TRACELENS_STRICT=false

# Local Ollama model. Pull it once with: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local persistent Chroma index and embedding model
CHROMA_PATH=./.chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_K=4
APP_VERSION=1.0.0
APP_ENV=local

# Optional SDK ingestion key. Configure the matching project_id -> key in backend .env.
TRACELENS_API_KEY=
