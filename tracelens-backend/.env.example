# Local development: start MongoDB with `docker compose up -d mongodb` from the project root.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tracelens
# Optional: set to a path to a CA bundle if your environment requires a custom CA.
# MONGODB_TLS_CA_FILE=
# AI root-cause investigation. Uses deterministic fallback if Ollama is unavailable.
RCA_PROVIDER=ollama
RCA_OLLAMA_BASE_URL=http://127.0.0.1:11434
RCA_OLLAMA_MODEL=qwen2.5:3b
RCA_TIMEOUT_SECONDS=45
