# ============================================================
# TraceLens — repository-wide .gitignore
# Place this file at the repository root (next to the .git folder)
# ============================================================

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
secrets/
.local/
*.secret

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
.eggs/
*.egg-info/
wheels/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/

# --- Node / React / Vite ---
node_modules/
.npm/
.pnpm-store/
.yarn/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/
dist/
build/
coverage/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Frontend local environment files ---
# (The general .env rules above apply; keep only example templates tracked.)

# --- Logs and temporary files ---
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
.DS_Store
Thumbs.db
Desktop.ini

# --- IDEs and editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml
*.sublime-workspace
*.sublime-project

# --- Local databases, caches, and vector stores ---
*.sqlite
*.sqlite3
*.db
*.mdb
.chroma/
chroma_db/
chromadb/
vector_store/
vectorstore/
faiss_index/
qdrant_storage/
weaviate_data/
milvus_data/
redis_data/
mongodb_data/
mongo-data/
data/local/
data/cache/

# --- TraceLens generated artifacts / exports ---
exports/
artifacts/
reports/generated/
*.trace.json
*.events.json
*.findings.json
*.dump
*.bson
*.archive
*.zip
*.tar
*.tar.gz
*.7z

# --- Local test and runtime output ---
.pytest_cache/
playwright-report/
test-results/
*.pid
*.seed

# --- OS-specific ---
$RECYCLE.BIN/
.Trashes/
